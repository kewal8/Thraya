# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ascendant Serif personal-use font files: licensed for local preview only, never published.
# Add the files (or the licensed web versions) to src/fonts/ascendant/ locally; see the README there.
/src/fonts/ascendant/*.otf
/src/fonts/ascendant/*.woff
/src/fonts/ascendant/*.woff2
